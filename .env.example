# Variaveis do Docker Compose. Gere valores proprios antes de executar.
JWT_CHAVE=
HASH_CHAVE=
SQL_SENHA=
REDIS_SENHA=

# TDE: cifra em repouso do banco inteiro (sem aspas simples). Guarde as duas fora do servidor.
TDE_SENHA_CHAVE_MESTRA=
TDE_SENHA_BACKUP=

# Limite de cadastros por hora e por IP (padrao 5). Eleve apenas para testes automatizados.
MAXIMO_CADASTROS_POR_HORA=5

# Configuracoes opcionais de entrega de e-mail.
Email__Ativo=false
Email__ServidorSmtp=
Email__Usuario=
Email__Senha=
Email__EmailRemetente=

# Producao (docker-compose.producao.yml). O infra/gerar-segredos.sh preenche tudo isto.
DOMINIO=
EMAIL_ACME=
# Express (gratuita, sem TDE) ou a chave do produto da Standard
SQL_EDICAO=
CERTIFICADO_CHAVES_SENHA=
Email__Porta=587
Email__UsarSsl=false
BACKUP_INTERVALO_HORAS=6
BACKUP_RETENCAO_DIAS=14

# Para execucao nativa use variaveis ASP.NET Core (nao sao carregadas de .env):
# Jwt__Chave, Seguranca__ChaveHashDados, ConnectionStrings__DefaultConnection,
# ConnectionStrings__Redis. Em Development sem Redis, o fallback e em memoria.
