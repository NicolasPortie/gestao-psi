# Variaveis do Docker Compose. Gere valores proprios antes de executar.
JWT_CHAVE=
HASH_CHAVE=
SQL_SENHA=
REDIS_SENHA=

# Limite de cadastros por hora e por IP (padrao 5). Eleve apenas para testes automatizados.
MAXIMO_CADASTROS_POR_HORA=5

# Configuracoes opcionais de entrega de e-mail.
Email__Ativo=false
Email__ServidorSmtp=
Email__Usuario=
Email__Senha=
Email__EmailRemetente=

# Para execucao nativa use variaveis ASP.NET Core (nao sao carregadas de .env):
# Jwt__Chave, Seguranca__ChaveHashDados, ConnectionStrings__DefaultConnection,
# ConnectionStrings__Redis. Em Development sem Redis, o fallback e em memoria.
